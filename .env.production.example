# Production / Render.com — set these in the Render dashboard
# (or copy to .env.production for a local production smoke test)

DJANGO_SETTINGS_MODULE=config.settings.production

SECRET_KEY=generate-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=your-service.onrender.com,yourdomain.rs

# Render injects this when you attach a PostgreSQL instance:
DATABASE_URL=postgres://user:password@host:5432/dbname

CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,https://yourdomain.rs
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_PRELOAD=False

LOG_LEVEL=INFO

# Email — HTTPS (port 443); SMTP is optional and needs hosting that allows it.
EMAIL_PROVIDER=auto
EMAIL_TIMEOUT=10
# Existing SendGrid key enables HTTPS sending automatically.
SENDGRID_API_KEY=
# Sender (verify this address or its domain with the selected provider)
SHOP_FROM_EMAIL=info@kodpendule.com
# Inbox for orders, contact form, low stock (defaults to kodpendule@gmail.com)
SHOP_NOTIFICATION_EMAIL=kodpendule@gmail.com
# Alternative: set EMAIL_PROVIDER=smtp and provide your mailbox SMTP credentials.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False

# Cloudflare R2 — product images (set USE_R2=True on Render)
USE_R2=True
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=media.yourdomain.rs
